.intro { padding: 34rpx 32rpx 10rpx; }
.intro-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
}
.intro-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #8a85a3;
}

.custom-day { margin-top: 14rpx; }

/* 字段下方的说明文字：讲清「提出人」和「负责人」分别是什么意思 */
