.login-page {
  min-height: 100vh;
  padding: 40rpx 52rpx 80rpx;
  background: linear-gradient(170deg, #efeaff 0%, #f4f2fa 42%, #fdf5ef 100%);
}

.center {
  padding-top: 38vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.center .brand-emoji { font-size: 96rpx; }
.center-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #8a85a3;
}

/* ---------- 品牌区 ---------- */
.hero { padding-top: 60rpx; }
.hero.small { padding-top: 120rpx; }

.brand-mark {
  width: 132rpx;
  height: 132rpx;
  border-radius: 42rpx;
  background: linear-gradient(140deg, #8d6bff, #6a47ff);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 68rpx;
  box-shadow: 0 24rpx 52rpx rgba(124, 92, 255, 0.34);
  margin-bottom: 44rpx;
}

.hero-title {
  font-size: 54rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  line-height: 1.32;
}
.hero-title .hl { color: #7c5cff; }

.hero-lead {
  margin-top: 26rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: #6c6789;
}

/* ---------- 三个卖点 ---------- */
.facts { margin: 60rpx 0 auto; }

.fact {
  display: flex;
  align-items: flex-start;
  background: rgba(255, 255, 255, 0.74);
  border-radius: 28rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 18rpx;
}
.fact-ic { font-size: 38rpx; margin-right: 20rpx; }
.fact-body { flex: 1; }
.fact-t {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}
.fact-d {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #77728f;
}

/* ---------- 操作区 ---------- */
.actions { margin-top: 60rpx; }
.actions .btn { margin-bottom: 22rpx; }

/* ---------- 表单 ---------- */
.form-title {
  padding-top: 50rpx;
  font-size: 46rpx;
  font-weight: 800;
}
.form-desc {
  font-size: 26rpx;
  color: #8a85a3;
  line-height: 1.7;
  margin: 16rpx 0 50rpx;
}

.code-input {
  letter-spacing: 12rpx;
  font-weight: 700;
  font-size: 38rpx;
}

.error {
  color: #ff5f6d;
  font-size: 25rpx;
  background: #ffeaec;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 24rpx;
}

.tip {
  font-size: 23rpx;
  color: #a49fbb;
  text-align: center;
  line-height: 1.6;
}
