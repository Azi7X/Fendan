<view class="page">

  <view class="head">
    <text class="head-title">付出统计</text>
    <text class="head-sub">{{scopeLabel}} · 让看不见的付出被看见</text>
  </view>

  <view class="segmented">
    <view
      wx:for="{{scopes}}"
      wx:key="key"
      class="item {{scope === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="setScope"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{loading}}" class="empty">
    <text class="em">⏳</text>
    <text class="line">正在加载…</text>
  </view>

  <view wx:elif="{{error}}" class="empty">
    <text class="em">😕</text>
    <text class="line">{{error}}</text>
  </view>

  <block wx:else>
    <!-- 三个总量 -->
    <view class="section">
      <view class="stat-grid">
        <view class="stat-box">
          <text class="stat-num">{{totalDone}}</text>
          <text class="stat-label">完成项数</text>
        </view>
        <view class="stat-box">
          <text class="stat-num">{{totalPoints}}</text>
          <text class="stat-label">获得积分</text>
        </view>
        <view class="stat-box">
          <text class="stat-num">{{fairness}}%</text>
          <text class="stat-label">公平度</text>
        </view>
      </view>
    </view>

    <!-- 谁做了多少 -->
    <view class="section">
      <view class="section-head">
        <text class="title">谁做了多少</text>
        <text class="count">按积分排序</text>
      </view>
      <view class="card">
        <view wx:if="{{members.length === 0}}" class="empty">
          <text class="line">还没有成员</text>
        </view>
        <view wx:for="{{members}}" wx:key="memberId" class="rank-row">
          <view class="avatar lg" style="background:{{item.color}}22">{{item.emoji}}</view>
          <view class="rank-info">
            <view class="rank-name">
              <text class="nm">{{item.name}}</text>
              <text class="sc">{{item.points}} 分 · {{item.doneCount}} 项</text>
            </view>
            <view class="bar">
              <view class="fill" style="width:{{item.percent}}%;background:{{item.color}}"></view>
            </view>
            <text class="rank-tag">{{item.tag}}</text>
          </view>
        </view>
      </view>

      <view class="fairness-note">
        <text class="fn-strong">公平度 {{fairness}}%</text>
        <text> —— {{verdict}}</text>
      </view>
    </view>

    <!-- 隐形家务占比 -->
    <view class="section">
      <view class="section-head">
        <text class="title">隐形家务占比</text>
        <text class="count">{{invisibleRatio}}%</text>
      </view>
      <view class="card">
        <view class="bar">
          <view class="fill invisible" style="width:{{invisibleRatio}}%"></view>
        </view>
        <view class="invisible-meta">
          <text>🧠 隐形家务 {{invisiblePoints}} 分</text>
          <text>合计 {{totalPoints}} 分</text>
        </view>
        <view class="invisible-note">
          记着买日用品、安排孩子行程、约维修……这些脑力活同样消耗精力，却最容易被当成「顺手就做了」。
        </view>
      </view>
    </view>

    <!-- 近 7 天趋势 -->
    <view class="section">
      <view class="section-head">
        <text class="title">近 7 天完成趋势</text>
        <text class="count">单位：积分</text>
      </view>
      <view class="card">
        <view class="trend">
          <view wx:for="{{series}}" wx:key="label" class="col">
            <view class="colbar {{item.zero ? 'zero' : ''}}" style="height:{{item.height}}rpx"></view>
            <text class="collabel">{{item.weekdayShort}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

</view>
